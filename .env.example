# Copy to .env and fill in values. Never commit .env or real keys.

# Stripe (publishable key for billing UI)
VITE_STRIPE_PUBLISHABLE_KEY=

# Referrals page: full register page URLs (no query string; ?ref= is added in the UI)
# Defaults match production: https://agent.gloriaconnect.com/agent/register and https://source.gloriaconnect.com/source/register
# VITE_AGENT_REGISTER_URL=
# VITE_SOURCE_REGISTER_URL=
